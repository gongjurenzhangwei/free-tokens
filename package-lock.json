{
  "name": "byok-copilot",
  "displayName": "免费 Token (Free Tokens)",
  "description": "Connect token plans, coding plans, and custom model endpoints to VS Code Copilot Chat.",
  "version": "1.5.24",
  "publisher": "byok-copilot",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "byokCopilot.openDashboard",
        "title": "免费 Token: Open Dashboard"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "byok-copilot",
        "displayName": "免费 Token (Free Tokens)"
      }
    ],
    "configuration": {
      "title": "免费 Token",
      "properties": {
        "byokCopilot.freeTokensUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL of the free-token recommendations page rendered inside the dashboard. Leave empty to use the page hosted at `docs/free-tokens.html` on the extension's GitHub `main` branch. Set a custom URL (e.g. self-hosted CDN) to override."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check": "tsc --noEmit",
    "compile:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "compile:webview": "esbuild src/webview/index.tsx --bundle --platform=browser --format=iife --outfile=dist/webview.js --sourcemap && tailwindcss -i src/webview/styles.css -o dist/webview.css --minify",
    "compile": "npm run compile:extension && npm run compile:webview",
    "package": "npm run check && npm run compile",
    "package:vsix": "npm run package && vsce package --allow-missing-repository --skip-license",
    "watch": "npm run compile -- --watch"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.9.2",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
